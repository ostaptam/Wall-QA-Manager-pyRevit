<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Wall QA Manager"
    Width="420"
    Height="340"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#2B2B2B">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border Margin="14" Padding="18" Background="#333333" CornerRadius="10">
        <StackPanel>

            <TextBlock
                Text="Wall QA Manager"
                FontSize="21"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                Margin="0,0,0,4"/>

            <TextBlock
                Text="Classify, audit and validate wall data"
                FontSize="12"
                Foreground="#B8B8B8"
                Margin="0,0,0,18"/>

            <Button
                x:Name="btn_classify"
                Content="Classify Walls  —  assign type data and fire rating"/>

            <Button
                x:Name="btn_audit"
                Content="Audit Walls  —  find issues and select elements"/>

            <Button
                x:Name="btn_full"
                Content="Full QA/QC  —  classify first, then audit"/>

            <Border
                Margin="0,8,0,0"
                Padding="10"
                Background="#2A2A2A"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="6">

                <TextBlock
                    Text="Rules: 510 / 380 / 100 mm walls, Fire Rating, Comments, Height > 3000 mm"
                    FontSize="11"
                    Foreground="#9E9E9E"
                    TextWrapping="Wrap"/>
            </Border>

            <TextBlock
                Text="pyRevit tool by Ostap Lypak"
                FontSize="11"
                Foreground="#777777"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"/>

        </StackPanel>
    </Border>
</Window>